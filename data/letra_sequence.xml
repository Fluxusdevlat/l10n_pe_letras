<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Secuencia para letras -->
    <record id="seq_letra" model="ir.sequence">
        <field name="name">Letra de Cambio</field>
        <field name="code">l10n.pe.letra</field>
        <field name="prefix">LC-%(year)s-</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Secuencia para planillas -->
    <record id="seq_letra_planilla" model="ir.sequence">
        <field name="name">Planilla de Letras</field>
        <field name="code">l10n.pe.letra.planilla</field>
        <field name="prefix">PL-%(year)s-</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Secuencia para protestos -->
    <record id="seq_letra_protesto" model="ir.sequence">
        <field name="name">Protesto de Letra</field>
        <field name="code">l10n.pe.letra.protesto</field>
        <field name="prefix">PR-%(year)s-</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Secuencia para renovaciones -->
    <record id="seq_letra_renovacion" model="ir.sequence">
        <field name="name">Renovación de Letra</field>
        <field name="code">l10n.pe.letra.renovacion</field>
        <field name="prefix">RN-%(year)s-</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
