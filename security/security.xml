<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Category -->
    <record id="module_category_letras" model="ir.module.category">
        <field name="name">Letras de Cambio</field>
        <field name="description">Gestión de Letras de Cambio</field>
        <field name="sequence">10</field>
    </record>

    <!-- Groups -->
    <record id="group_letra_user" model="res.groups">
        <field name="name">Usuario</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_letra_manager" model="res.groups">
        <field name="name">Administrador</field>
        <field name="implied_ids" eval="[(4, ref('l10n_pe_letras.group_letra_user'))]"/>
    </record>

    <!-- Record Rules -->
    <record id="rule_letra_company" model="ir.rule">
        <field name="name">Letra: multi-compañía</field>
        <field name="model_id" ref="model_l10n_pe_letra"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_letra_planilla_company" model="ir.rule">
        <field name="name">Planilla Letra: multi-compañía</field>
        <field name="model_id" ref="model_l10n_pe_letra_planilla"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_credit_group_company" model="ir.rule">
        <field name="name">Grupo Crédito: multi-compañía</field>
        <field name="model_id" ref="model_l10n_pe_credit_group"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
