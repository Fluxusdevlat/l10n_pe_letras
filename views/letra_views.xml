<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_letra_tree" model="ir.ui.view">
        <field name="name">l10n.pe.letra.tree</field>
        <field name="model">l10n.pe.letra</field>
        <field name="arch" type="xml">
            <list string="Letras de Cambio" default_order="date_emission desc">
                <header>
                    <button name="%(action_generate_letras_from_invoices)d" string="Generar Letras desde Facturas" type="action" class="btn-primary"/>
                </header>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="salesperson_id"/>
                <field name="instrument_type"/>
                <field name="bank_id"/>
                <field name="unique_number"/>
                <field name="amount_total" widget="monetary" sum="Total"/>
                <field name="amount_residual" widget="monetary"/>
                <field name="date_emission"/>
                <field name="days_term"/>
                <field name="date_due"/>
                <field name="state" widget="badge" decoration-danger="state in ('protested','cancelled')"
                       decoration-success="state in ('paid')"
                       decoration-info="state in ('signed','in_bank')"
                       decoration-warning="state in ('draft','sent')"/>
                <field name="tipo"/>
            </list>
        </field>
    </record>

    <record id="view_letra_form" model="ir.ui.view">
        <field name="name">l10n.pe.letra.form</field>
        <field name="model">l10n.pe.letra</field>
        <field name="arch" type="xml">
            <form string="Letra de Cambio">
                <header>
                    <button name="action_sent" string="Enviar al Cliente"
                            type="object" invisible="state != 'draft'"
                            class="btn-primary"/>
                    <button name="action_signed" string="Registrar Firma"
                            type="object" invisible="state != 'sent' or not can_sign or instrument_type == 'cabal'"
                            class="btn-primary"/>
                    <button string="Registrar Firma"
                            disabled="1"
                            invisible="state != 'sent' or can_sign or instrument_type == 'cabal'"
                            class="btn-secondary"/>
                    <button name="action_send_to_bank" string="Enviar al Banco"
                            type="object"
                            invisible="state != 'signed' and not (instrument_type == 'cabal' and state in ('draft', 'sent'))"
                            class="btn-primary"/>
                    <button name="action_register_protest" string="Registrar Protesto"
                            type="object" invisible="state != 'in_bank'"
                            class="btn-danger"/>
                    <button name="action_renew" string="Renovar"
                            type="object" invisible="state not in ('in_bank', 'protested')"
                            class="btn-warning"/>
                    <button name="action_paid" string="Registrar Pago"
                            type="object" invisible="state not in ('in_bank', 'signed')"
                            class="btn-success"/>
                    <button name="action_cancel" string="Anular"
                            type="object" invisible="state not in ('draft', 'sent', 'signed')"
                            class="btn-secondary"/>
                    <button name="action_print_letra" string="Imprimir Letra para Firma"
                            type="object"
                            class="btn-secondary"/>
                    <button name="action_view_signed_document" string="Ver Letra Firmada"
                            type="object" class="btn-secondary"
                            invisible="not signed_document"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,sent,signed,in_bank,paid"
                           statusbar_colors='{"protested":"red","cancelled":"gray"}'
                           clickable="False"/>
                </header>
                <sheet>
                    <field name="can_sign" invisible="1"/>
                    <field name="signed_filename" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_letra_protesto)d" type="action"
                                class="oe_stat_button" icon="fa-exclamation-triangle"
                                context="{'default_letra_id': id}">
                            <div class="o_stat_info">
                                <field name="protesto_count"/>
                            </div>
                            <span>Protestos</span>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="partner_id" options="{'no_create': True}"/>
                            <field name="salesperson_id" readonly="1"/>
                            <field name="instrument_type"/>
                            <field name="tipo"/>
                            <field name="bank_id" options="{'no_create': True}"/>
                            <field name="planilla_id" readonly="1"/>
                            <field name="signed_document" filename="signed_filename"
                                   widget="binary" string="Cargar Letra Firmada (PDF)"
                                   invisible="instrument_type == 'cabal'"/>
                        </group>
                        <group>
                            <field name="date_emission"/>
                            <field name="days_term"/>
                            <field name="date_due"/>
                            <field name="unique_number"/>
                            <field name="internal_bank_number"/>
                            <field name="date_payment" readonly="1"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Importes">
                        <group>
                            <field name="amount_total" widget="monetary"/>
                        </group>
                        <group>
                            <field name="amount_paid" widget="monetary"/>
                            <field name="amount_residual" widget="monetary"/>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert"
                         invisible="state != 'sent' or can_sign or instrument_type == 'cabal'">
                        Cargue la letra firmada y sellada en formato <strong>PDF</strong> en el campo
                        <strong>Cargar Letra Firmada (PDF)</strong> para habilitar el botón
                        <strong>Registrar Firma</strong>.
                    </div>
                    <div class="alert alert-success" role="alert"
                         invisible="state != 'sent' or not can_sign or instrument_type == 'cabal'">
                        Documento firmado cargado. Ya puede presionar
                        <strong>Registrar Firma</strong>.
                    </div>
                    <notebook>
                        <page string="Facturas Asociadas">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="move_id" domain="[('move_type', '=', 'out_invoice'), ('payment_state', 'not in', ('paid', 'reversed')), ('partner_id', '=?', parent.partner_id), ('letra_state', '!=', 'total')]" options="{'no_create': True}"/>
                                    <field name="amount" widget="monetary"/>
                                    <field name="amount_residual" widget="monetary"/>
                                    <field name="date_invoice"/>
                                </list>
                            </field>
                        </page>
                        <page string="Renovaciones">
                            <field name="renovacion_destino_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="date_due"/>
                                    <field name="amount_total" widget="monetary"/>
                                    <field name="state"/>
                                </list>
                            </field>
                            <field name="renovacion_origin_id"/>
                        </page>
                        <page string="Observaciones">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>


            </form>
        </field>
    </record>

    <record id="view_letra_pivot" model="ir.ui.view">
        <field name="name">l10n.pe.letra.pivot</field>
        <field name="model">l10n.pe.letra</field>
        <field name="arch" type="xml">
            <pivot string="Proyección Semanal de Cobranza">
                <field name="salesperson_id" type="row"/>
                <field name="partner_id" type="row"/>
                <field name="date_due" type="col"/>
                <field name="amount_total" type="measure"/>
                <field name="amount_residual" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_letra_graph" model="ir.ui.view">
        <field name="name">l10n.pe.letra.graph</field>
        <field name="model">l10n.pe.letra</field>
        <field name="arch" type="xml">
            <graph string="Proyección de Cobranza por Vendedor" type="bar">
                <field name="salesperson_id"/>
                <field name="amount_residual" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_letra_search" model="ir.ui.view">
        <field name="name">l10n.pe.letra.search</field>
        <field name="model">l10n.pe.letra</field>
        <field name="arch" type="xml">
            <search string="Buscar Letra">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="salesperson_id"/>
                <field name="bank_id"/>
                <field name="unique_number"/>
                <filter string="Letras de Cambio" name="inst_letra"
                        domain="[('instrument_type','=','letra')]"/>
                <filter string="Cabal" name="inst_cabal"
                        domain="[('instrument_type','=','cabal')]"/>
                <separator/>
                <filter string="Borrador" name="state_draft"
                        domain="[('state','=','draft')]"/>
                <filter string="Enviada" name="state_sent"
                        domain="[('state','=','sent')]"/>
                <filter string="En Banco" name="state_in_bank"
                        domain="[('state','=','in_bank')]"/>
                <filter string="Protestadas" name="state_protested"
                        domain="[('state','=','protested')]"/>
                <filter string="Pagadas" name="state_paid"
                        domain="[('state','=','paid')]"/>
                <separator/>
                <filter string="Estado" name="group_state"
                        context="{'group_by': 'state'}"/>
                <filter string="Cliente" name="group_partner"
                        context="{'group_by': 'partner_id'}"/>
                <filter string="Vendedor" name="group_salesperson"
                        context="{'group_by': 'salesperson_id'}"/>
                <filter string="Banco" name="group_bank"
                        context="{'group_by': 'bank_id'}"/>
                <filter string="Vencimiento" name="group_due"
                        context="{'group_by': 'date_due'}"/>
            </search>
        </field>
    </record>

    <record id="action_letra" model="ir.actions.act_window">
        <field name="name">Letras de Cambio</field>
        <field name="res_model">l10n.pe.letra</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="help" type="html">
            <p>Gestione las letras de cambio emitidas a sus clientes.</p>
        </field>
    </record>

    <record id="action_letra_cabal" model="ir.actions.act_window">
        <field name="name">Operaciones Cabal</field>
        <field name="res_model">l10n.pe.letra</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="domain">[('instrument_type','=','cabal')]</field>
        <field name="context">{'default_instrument_type':'cabal'}</field>
    </record>

    <record id="action_proyeccion_cobranza" model="ir.actions.act_window">
        <field name="name">Proyección Semanal de Cobranza</field>
        <field name="res_model">l10n.pe.letra</field>
        <field name="view_mode">pivot,graph,list</field>
        <field name="context">{'search_default_group_due': 1, 'search_default_group_salesperson': 1}</field>
    </record>

</odoo>
