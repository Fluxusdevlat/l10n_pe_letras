<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_partner_form_inherit_letra" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.letra</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Letras de Cambio" name="letras"
                      invisible="not is_company">
                    <field name="credit_near_limit" invisible="1"/>
                    <div class="alert alert-warning" role="alert"
                         invisible="not credit_near_limit">
                        El cliente está usando el <strong>90% o más</strong> de su
                        línea de crédito del grupo empresarial.
                    </div>
                    <group>
                        <group>
                            <field name="credit_group_id"/>
                            <field name="letra_days_term"/>
                            <field name="commercial_blocked"/>
                            <field name="commercial_block_reason" readonly="1"/>
                        </group>

                        <group>
                            <field name="letra_count"/>
                            <field name="has_letras_protestadas"/>
                            <field name="credit_usage_pct" widget="percentage"/>
                        </group>
                    </group>
                    <field name="letra_ids">
                        <list>
                            <field name="name"/>
                            <field name="amount_total" widget="monetary"/>
                            <field name="amount_residual" widget="monetary"/>
                            <field name="date_due"/>
                            <field name="state" widget="badge"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="action_letras_clientes" model="ir.actions.act_window">
        <field name="name">Estado de Cuenta de Letras</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_company', '=', True)]</field>
        <field name="help" type="html">
            <p>Abra la ficha de un cliente y use <b>Imprimir → Estado de Cuenta de Letras</b>.</p>
        </field>
    </record>
</odoo>
