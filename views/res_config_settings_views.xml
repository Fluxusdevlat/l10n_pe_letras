<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_config_settings_letras" model="ir.ui.view">
        <field name="name">res.config.settings.letras.inherit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <field name="letras_currency_id" invisible="1"/>
                <app data-string="Letras de Cambio" string="Letras de Cambio"
                     name="letras_settings"
                     logo="/l10n_pe_letras/static/description/icon.png">
                    <block title="Configuración de Letras de Cambio" name="letras_config_block">
                        <setting id="letras_email_setting"
                                 string="Email para envío de Letras"
                                 help="Correo destino predeterminado para el wizard 'Enviar Letras por Email'"
                                 groups="account.group_account_manager">
                            <field name="letras_email_to" placeholder="correo@ejemplo.com"/>
                        </setting>
                        <setting id="letras_global_limit_setting"
                                 string="Techo Agregado de Líneas de Crédito"
                                 help="Monto máximo que puede sumar el total de líneas de crédito de los grupos empresariales. Use 0 para no aplicar límite."
                                 groups="account.group_account_manager">
                            <field name="letras_global_credit_limit" widget="monetary"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
