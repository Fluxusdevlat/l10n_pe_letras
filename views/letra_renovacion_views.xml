<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_letra_renovacion_tree" model="ir.ui.view">
        <field name="name">l10n.pe.letra.renovacion.tree</field>
        <field name="model">l10n.pe.letra.renovacion</field>
        <field name="arch" type="xml">
            <list string="Renovaciones">
                <field name="name"/>
                <field name="letra_origin_id"/>
                <field name="letra_new_id"/>
                <field name="date"/>
                <field name="amount_origin" widget="monetary"/>
                <field name="amount_new" widget="monetary"/>
                <field name="intereses" widget="monetary"/>
                <field name="difference" widget="monetary"/>
                <field name="reason"/>
            </list>
        </field>
    </record>

    <record id="view_letra_renovacion_form" model="ir.ui.view">
        <field name="name">l10n.pe.letra.renovacion.form</field>
        <field name="model">l10n.pe.letra.renovacion</field>
        <field name="arch" type="xml">
            <form string="Renovación de Letra">
                <sheet>
                    <group>
                        <group>
                            <field name="letra_origin_id"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="amount_origin" widget="monetary"/>
                            <field name="intereses" widget="monetary"/>
                            <field name="gastos" widget="monetary"/>
                            <field name="amount_new" widget="monetary"/>
                            <field name="difference" widget="monetary"/>
                        </group>
                    </group>
                    <group>
                        <field name="letra_new_id"/>
                        <field name="reason"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_letra_renovacion" model="ir.actions.act_window">
        <field name="name">Renovaciones</field>
        <field name="res_model">l10n.pe.letra.renovacion</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
