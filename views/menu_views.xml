<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Menú principal de Letras -->
    <menuitem id="menu_letras_root"
              name="Letras de Cambio"
              sequence="10"
              web_icon="l10n_pe_letras,static/description/icon.png"/>

    <!-- Submenú de Operaciones -->
    <menuitem id="menu_letras_operations"
              name="Operaciones"
              parent="menu_letras_root"
              sequence="10"/>

    <menuitem id="menu_letras_letras"
              name="Letras de Cambio"
              parent="menu_letras_operations"
              action="action_letra"
              sequence="1"/>

    <menuitem id="menu_letras_cabal"
              name="Operaciones Cabal"
              parent="menu_letras_operations"
              action="action_letra_cabal"
              sequence="15"/>

    <menuitem id="menu_letras_planillas"
              name="Planillas"
              parent="menu_letras_operations"
              action="action_letra_planilla"
              sequence="20"/>

    <menuitem id="menu_letras_generate_wizard"
              name="Generar Letras desde Facturas"
              parent="menu_letras_operations"
              action="action_generate_letras_from_invoices"
              sequence="30"/>

    <!-- Submenú de Seguimiento -->
    <menuitem id="menu_letras_tracking"
              name="Seguimiento"
              parent="menu_letras_root"
              sequence="20"/>

    <menuitem id="menu_letras_cartera"
              name="Letras en Cartera"
              parent="menu_letras_tracking"
              action="action_letra_cartera"
              sequence="3"/>

    <menuitem id="menu_letras_proyeccion"
              name="Proyección Semanal"
              parent="menu_letras_tracking"
              action="action_proyeccion_cobranza"
              sequence="5"/>

    <menuitem id="menu_letras_protestos"
              name="Protestos"
              parent="menu_letras_tracking"
              action="action_letra_protesto"
              sequence="10"/>

    <menuitem id="menu_letras_protestadas"
              name="Letras Protestadas"
              parent="menu_letras_tracking"
              action="action_letra_protestadas"
              sequence="15"/>

    <menuitem id="menu_letras_renovaciones"
              name="Renovaciones"
              parent="menu_letras_tracking"
              action="action_letra_renovacion"
              sequence="20"/>

    <!-- Submenú de Reportes -->
    <menuitem id="menu_letras_reports"
              name="Reportes"
              parent="menu_letras_root"
              sequence="30"/>

    <menuitem id="menu_letras_report_proyeccion"
              name="Proyección Semanal (Pivot)"
              parent="menu_letras_reports"
              action="action_proyeccion_cobranza"
              sequence="10"/>

    <menuitem id="menu_letras_report_excel"
              name="Exportar Resumen Excel / Email"
              parent="menu_letras_reports"
              action="action_enviar_letras_wizard"
              sequence="20"/>

    <record id="action_letras_sequence" model="ir.actions.act_window">
        <field name="name">Secuencias de Letras</field>
        <field name="res_model">ir.sequence</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('code', 'in', ['l10n.pe.letra', 'l10n.pe.letra.planilla', 'l10n.pe.letra.protesto', 'l10n.pe.letra.renovacion'])]</field>
    </record>

    <menuitem id="menu_letras_report_estado_cuenta"
              name="Estado de Cuenta"
              parent="menu_letras_reports"
              action="action_letras_clientes"
              sequence="15"/>


    <!-- Configuración -->

    <menuitem id="menu_letras_config"
              name="Configuración"
              parent="menu_letras_root"
              sequence="90"/>

    <menuitem id="menu_credit_groups"
              name="Grupos Empresariales"
              parent="menu_letras_config"
              action="action_credit_group"
              sequence="10"/>

    <record id="action_letras_bancos" model="ir.actions.act_window">
        <field name="name">Bancos</field>
        <field name="res_model">res.bank</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_letras_bancos"
              name="Bancos"
              parent="menu_letras_config"
              action="action_letras_bancos"
              sequence="20"/>

    <menuitem id="menu_letras_secuencias"
              name="Secuencias"
              parent="menu_letras_config"
              action="action_letras_sequence"
              sequence="30"/>

    <!-- Integración en menú existente de Contabilidad -->
    <menuitem id="menu_letras_accounting"
              name="Letras de Cambio"
              parent="account.menu_finance_receivables"
              sequence="50"
              action="action_letra"/>
</odoo>

