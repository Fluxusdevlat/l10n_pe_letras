<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_credit_group_tree" model="ir.ui.view">
        <field name="name">l10n.pe.credit.group.tree</field>
        <field name="model">l10n.pe.credit.group</field>
        <field name="arch" type="xml">
            <list string="Grupos Empresariales">
                <field name="name"/>
                <field name="partner_count"/>
                <field name="credit_limit" widget="monetary"/>
                <field name="credit_used" widget="monetary"/>
                <field name="credit_available" widget="monetary"/>
            </list>
        </field>
    </record>

    <record id="view_credit_group_form" model="ir.ui.view">
        <field name="name">l10n.pe.credit.group.form</field>
        <field name="model">l10n.pe.credit.group</field>
        <field name="arch" type="xml">
            <form string="Grupo Empresarial">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_letra)d" type="action"
                                class="oe_stat_button" icon="fa-file-text-o">
                            <div class="o_stat_info">
                                <field name="partner_count"/>
                            </div>
                            <span>Empresas</span>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="credit_limit" widget="monetary"/>
                        </group>
                        <group>
                            <field name="credit_used" widget="monetary"/>
                            <field name="credit_available" widget="monetary"/>
                        </group>
                    </group>
                    <group string="Desglose">
                        <field name="invoiced_amount" widget="monetary"/>
                        <field name="pending_orders_amount" widget="monetary"/>
                    </group>
                    <notebook>
                        <page string="Empresas del Grupo">
                            <field name="partner_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="vat"/>
                                    <field name="commercial_blocked"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_credit_group_search" model="ir.ui.view">
        <field name="name">l10n.pe.credit.group.search</field>
        <field name="model">l10n.pe.credit.group</field>
        <field name="arch" type="xml">
            <search string="Buscar Grupo Empresarial">
                <field name="name"/>
            </search>
        </field>
    </record>

    <record id="action_credit_group" model="ir.actions.act_window">
        <field name="name">Grupos Empresariales</field>
        <field name="res_model">l10n.pe.credit.group</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p>Defina los grupos empresariales para administrar líneas de crédito compartidas.</p>
        </field>
    </record>
</odoo>
