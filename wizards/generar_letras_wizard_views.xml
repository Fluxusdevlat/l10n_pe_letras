<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_generate_letras_wizard_form" model="ir.ui.view">
        <field name="name">l10n.pe.letra.generate.wizard.form</field>
        <field name="model">l10n.pe.letra.generate.wizard</field>
        <field name="arch" type="xml">
            <form string="Generar Letras desde Facturas">
                <group>
                    <group>
                        <field name="generate_option" widget="radio"/>
                        <field name="invoice_ids" widget="many2many_tags"/>
                    </group>
                    <group>
                        <field name="bank_id"/>
                        <field name="date_emission"/>
                        <field name="date_due"/>
                        <field name="amount_total" widget="monetary"/>
                    </group>
                </group>
                <footer>
                    <button name="action_generate" string="Generar Letra(s)"
                            type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_generate_letras_from_invoices" model="ir.actions.act_window">
        <field name="name">Generar Letras</field>
        <field name="res_model">l10n.pe.letra.generate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="account.model_account_move"/>
        <field name="binding_view_types">list</field>
    </record>
</odoo>
