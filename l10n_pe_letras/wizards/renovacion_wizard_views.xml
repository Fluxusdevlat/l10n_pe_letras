<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_letra_renovacion_wizard_form" model="ir.ui.view">
        <field name="name">l10n.pe.letra.renovacion.wizard.form</field>
        <field name="model">l10n.pe.letra.renovacion.wizard</field>
        <field name="arch" type="xml">
            <form string="Renovar Letra">
                <group>
                    <group>
                        <field name="letra_origin_id" readonly="1"/>
                        <field name="partner_id" readonly="1"/>
                        <field name="bank_id"/>
                    </group>
                    <group>
                        <field name="date_emission"/>
                        <field name="date_due"/>
                    </group>
                </group>
                <group string="Importes">
                    <group>
                        <field name="amount_origin" widget="monetary"/>
                    </group>
                    <group>
                        <field name="intereses" widget="monetary"/>
                        <field name="gastos" widget="monetary"/>
                        <field name="amount_new" widget="monetary"/>
                    </group>
                </group>
                <group>
                    <field name="reason"/>
                </group>
                <footer>
                    <button name="action_renew" string="Generar Renovación"
                            type="object" class="btn-primary"/>
                    <button string="Cancelar" class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
