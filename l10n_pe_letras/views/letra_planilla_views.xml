<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_letra_planilla_tree" model="ir.ui.view">
        <field name="name">l10n.pe.letra.planilla.tree</field>
        <field name="model">l10n.pe.letra.planilla</field>
        <field name="arch" type="xml">
            <list string="Planillas de Letras">
                <field name="name"/>
                <field name="bank_id"/>
                <field name="date"/>
                <field name="letra_count"/>
                <field name="amount_total" widget="monetary" sum="Total"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="view_letra_planilla_form" model="ir.ui.view">
        <field name="name">l10n.pe.letra.planilla.form</field>
        <field name="model">l10n.pe.letra.planilla</field>
        <field name="arch" type="xml">
            <form string="Planilla de Letras">
                <header>
                    <button name="action_send" string="Enviar al Banco"
                            type="object" invisible="state != 'draft'"
                            class="btn-primary"/>
                    <button name="action_confirm" string="Confirmar"
                            type="object" invisible="state != 'sent'"
                            class="btn-primary"/>
                    <button name="action_print_planilla" string="Imprimir Planilla"
                            type="object" class="btn-secondary"/>
                    <button name="action_print_letras" string="Imprimir Letras"
                            type="object" class="btn-secondary"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="bank_id"/>
                            <field name="date"/>
                        </group>
                        <group>
                            <field name="letra_count"/>
                            <field name="amount_total" widget="monetary"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Letras">
                            <field name="letra_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="amount_total" widget="monetary"/>
                                    <field name="date_due"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Observaciones">
                            <field name="notes"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_letra_planilla" model="ir.actions.act_window">
        <field name="name">Planillas de Letras</field>
        <field name="res_model">l10n.pe.letra.planilla</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
