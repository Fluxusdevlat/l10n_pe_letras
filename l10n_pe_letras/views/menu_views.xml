<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Menú principal de Letras -->
    <menuitem id="menu_letras_root"
              name="Letras de Cambio"
              sequence="10"
              web_icon="l10n_pe_letras,static/description/icon.png"/>

    <!-- Submenú de Operaciones -->
    <menuitem id="menu_letras_operations"
              name="Operaciones"
              parent="menu_letras_root"
              sequence="10"/>

    <menuitem id="menu_letras_letras"
              name="Letras de Cambio"
              parent="menu_letras_operations"
              action="action_letra"
              sequence="10"/>

    <menuitem id="menu_letras_planillas"
              name="Planillas"
              parent="menu_letras_operations"
              action="action_letra_planilla"
              sequence="20"/>

    <!-- Submenú de Seguimiento -->
    <menuitem id="menu_letras_tracking"
              name="Seguimiento"
              parent="menu_letras_root"
              sequence="20"/>

    <menuitem id="menu_letras_protestos"
              name="Protestos"
              parent="menu_letras_tracking"
              action="action_letra_protesto"
              sequence="10"/>

    <menuitem id="menu_letras_renovaciones"
              name="Renovaciones"
              parent="menu_letras_tracking"
              action="action_letra_renovacion"
              sequence="20"/>

    <!-- Configuración -->
    <menuitem id="menu_letras_config"
              name="Configuración"
              parent="menu_letras_root"
              sequence="90"/>

    <menuitem id="menu_credit_groups"
              name="Grupos Empresariales"
              parent="menu_letras_config"
              action="action_credit_group"
              sequence="10"/>

    <!-- Integración en menú existente de Contabilidad -->
    <menuitem id="menu_letras_accounting"
              name="Letras de Cambio"
              parent="account.menu_finance_receivables"
              sequence="50"
              action="action_letra"/>
</odoo>
